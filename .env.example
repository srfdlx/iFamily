# Server
PORT=3000
APP_URL=http://localhost:3000

# MySQL / MariaDB (metanet.ch Zugangsdaten)
DB_HOST=localhost
DB_PORT=3306
DB_USER=ifamily
DB_PASSWORD=
DB_NAME=ifamily

# Session-Token Gültigkeit (Tage) - langlebig, damit man nicht staendig neu einloggen muss
SESSION_TTL_DAYS=90
# Magic-Link Gültigkeit (Minuten)
MAGIC_LINK_TTL_MINUTES=15

# SMTP fuer Magic-Link E-Mails (metanet.ch Mailhosting oder anderer Anbieter)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="iFamily <noreply@example.ch>"

# Web Push (VAPID) - Erzeugen mit: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.ch
